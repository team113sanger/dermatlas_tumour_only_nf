params {
    germline_vcfs = "${PROJECT_DIR}/analysis/unmatched/germline_variant_files.tsv"
    unmatched_somatic_vcfs = "${PROJECT_DIR}/analysis/unmatched/unmatched_somatic_vcfs.tsv"
    matched_somatic_vcfs = "${PROJECT_DIR}/analysis/unmatched/matched_somatic_vcfs.tsv"
    unmatched_maf = "${PROJECT_DIR}/analysis/unmatched/combined_cohorts_keep_unmatched.maf"
    release_version = "v1"
    outdir = "${PROJECT_DIR}/analysis/unmatched_variant_calling"

    // Define multiple cohorts with their sample lists
    // Each cohort name will be used as a subdirectory in the output
    cohorts = [
        "all_samples": "${PROJECT_DIR}/metadata/${STUDY}_${PROJECT}-one_tumour_per_patient_unmatched.tsv",
        // Add more cohorts as needed:
        // "cohort1": "${PROJECT_DIR}/metadata/cohort1_samples.tsv",
        // "cohort2": "${PROJECT_DIR}/metadata/cohort2_samples.tsv"
    ]
}
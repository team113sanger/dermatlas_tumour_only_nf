
/*
========================================================================================
  Nextflow config file
========================================================================================
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// One id names all of a run's artifacts - nextflow log (nextflow-<RUN_ID>.log),
// execution trace (execution_trace-<RUN_ID>.txt) and execution report
// (execution_report-<RUN_ID>.html) - so they can be matched up at a glance.
// The run wrapper computes and exports RUN_ID (label/study_project_cohort plus a
// YYYYMMDDTHHMMSS timestamp); direct `nextflow run` invocations fall back to a
// bare timestamp in the same format.
def run_id = System.getenv('RUN_ID') ?: new java.util.Date().format("yyyyMMdd'T'HHmmss")

// Where this run's execution trace and report go. The run wrapper exports TRACE_DIR;
// System.getenv (rather than a "${TRACE_DIR}" interpolation) is used deliberately - an
// unset variable in a Nextflow config string silently becomes the literal '[:]', whereas
// getenv returns null and falls back cleanly here.
def trace_dir  = System.getenv('TRACE_DIR') ?: 'results/pipeline_info'
def trace_path = "${trace_dir}/execution_trace-${run_id}.txt"

// Global default params, used in configs
params {

    // Boilerplate options
    outdir                     = './results'
    tracedir                   = "${params.outdir}/pipeline_info"
    // Load-bearing: the run wrapper deletes the work directory after a successful run,
    // which is only safe because publishDir has already copied the results out.
    publish_dir_mode           = 'copy'

    // Skip status reporting for stub/test runs (accepts true/false/1/0).
    // `-stub-run` on the CLI (workflow.stubRun) is also honoured, so this flag
    // is only needed where that is unavailable.
    is_stub                    = false

    // Run reporting is deliberately kept out of the workflow's params: it is gated by
    // two env-var opt-ins exported by the run wrapper (see assets/run_tumour_only.sh)
    // and lib/Utils.groovy reads everything it needs (COHORT_SLUG,
    // SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL, RUN_ID)
    // straight from the environment in the onComplete handler:
    //   DERMATLAS_WEBSITE_LOGGING     - record the run via `dermatlas-http cohort
    //                                   analysis-log` (>= 0.6.1).
    //   DERMATLAS_SLACK_NOTIFICATIONS - post a Slack message on completion.
    // The one reporting value that is a param is this pipeline's own slug in the
    // analysis log - pipeline-owned metadata, like the manifest version.
    analysis_pipeline_slug     = 'unmatched_variants_pipe'

    // Path of this run's execution trace. Assigned from the same value as trace.file below,
    // so the two can never drift; read by the onComplete handler and attached to the
    // analysis-log record (--nextflow-performance) when website logging is opted in.
    trace_file                 = trace_path

    // Max requirements
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    // Run inputs - all required, validated at the top of the workflow. Supplied
    // by the run's own -c config (see assets/tumour_only.config), not here.
    //   germline_vcfs          : file of germline VCF paths, one per line
    //   matched_somatic_vcfs   : file of matched somatic VCF paths, one per line
    //   unmatched_somatic_vcfs : file of unmatched somatic VCF paths, one per line
    //   unmatched_maf          : collated unmatched MAF from dermatlas_somatic_qc_nf
    germline_vcfs              = null
    matched_somatic_vcfs       = null
    unmatched_somatic_vcfs     = null
    unmatched_maf              = null

    // Results release version. Becomes a "release_<version>" directory under
    // outdir, so an unset value would silently publish into "release_null".
    release_version            = null

    // Prefix for the filtered/annotated MAF and the config.R that names it. The
    // default reproduces the historical output filenames.
    study_id                   = 'combined_cohorts_keep_unmatched'

    // Cohorts - map of cohort name to sample-list path. Each cohort becomes its
    // own set of tiered MAFs and plots. At least one is required.
    // Example:
    // cohorts = [
    //     "cohort_a": "/path/to/cohort_a_samples.tsv",
    //     "cohort_b": "/path/to/cohort_b_samples.tsv",
    // ]
    cohorts                    = [:]

    // Reference data - site-specific, supplied by the -profile below.
    transcripts                = null
    transcript_info            = null
    cgc_file                   = null
    oncokb_file                = null
    hotspot_file               = null
    dbsnp_file                 = null
} 

profiles {
    secure_lustre {
        process.executor = 'local'
        
        docker {
        enabled = true
        runOptions = '-u $(id -u):$(id -g)'
        }
        singularity {
            enabled    = false
            autoMounts = false
        }
        aws {
        client {
        endpoint = "https://cog.sanger.ac.uk"
        signerOverride = "S3SignerType"
        }}

    }

    farm22 {
        process.executor = 'lsf'
        singularity.runOptions = "--bind /lustre"

        docker {
        enabled = false
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir = '/lustre/scratch127/casm/projects/dermatlas/singularity_images'
            registry = 'gitlab-registry.internal.sanger.ac.uk'

            }
        executor {
            name = 'lsf'
            perJobMemLimit = true
            poolSize = 4
            submitRateLimit = '5 sec'
            killBatchSize = 50
        }
        params {
            transcripts = "/lustre/scratch127/casm/projects/dermatlas/resources/ensembl/dermatlas_noncanonical_transcripts_ens103.v2.tsv"
            cgc_file = "/lustre/scratch127/casm/projects/dermatlas/resources/tumour-only/cgc_genes.list"
            oncokb_file = "/lustre/scratch127/casm/projects/dermatlas/resources/oncokb/cancerGeneList.list"
            hotspot_file = "/lustre/scratch127/casm/projects/dermatlas/resources/tumour-only/cancerhotspots_metadata.GRCh38.v2.tsv"
            dbsnp_file = "/lustre/scratch127/casm/projects/dermatlas/resources/tumour-only/dbSNP155.GRCh38.GCF_000001405.39_AFS.WES5.tsv.gz{,.tbi}"
        }

        process {
            withName: COUNT_NON_REF_GTS {
                cpus = 4
                memory = 10.GB
            }
            withName: SUBSET_MAF {
                cpus = 4
                memory = 10.GB
            }
            withName: CHECK_SOMATIC_MNV_CALLS {
                cpus = 4
                memory = 40.GB
            }
            withName: FIND_SNP_POSITIONS {
                cpus = 4
                memory = 40.GB
            }
            withName: GENERATE_CONFIG_FILE {
                cpus = 4
                memory = 40.GB
            }
            withName: FILTER_AND_FLAG_VARIANTS {
                cpus = 4
                memory = 40.GB
            }
            withName: CATEGORISE_VARIANTS {
                cpus = 4
                memory = 40.GB
            }
            withName: PLOT_VARIANTS {
                cpus = 4
                memory = 40.GB
            }
        }

        }
}


// Both built from trace_dir, not params.tracedir: that resolves eagerly against the
// default outdir, so the report would otherwise land in ./results/pipeline_info.
report {
    enabled = true
    file    = "${trace_dir}/execution_report-${run_id}.html"
}

trace {
    enabled   = true
    file      = trace_path
    overwrite = false
}


manifest {
    name            = 'dermatlas_tumour_only_calling_nf'
    author          = 'Kim Wong, Jamie Billington'
    homePage        = 'https://github.com/team113sanger/dermatlas_tumour_only_nf'
    description     = 'Tumour-only variant calling pipeline for Dermatlas'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.04.5'
    version         = '0.2.0'
    defaultBranch   = 'develop'
}

